# Canonical origin for this driver app (no trailing slash). Production required for SEO/OG/JSON-LD.
NEXT_PUBLIC_SITE_URL=https://drivers.goliftngo.com

# --- Backend sync (local / ngrok / staging) ---
# One URL for Nest REST + Socket.IO (same origin). Overrides localhost defaults for BOTH API and socket
# unless you set the specific overrides below.
# NEXT_PUBLIC_NGROK_BACKEND_URL=https://YOUR_SUBDOMAIN.ngrok-free.app
#
# Optional split overrides (e.g. different tunnels):
# NEXT_PUBLIC_LIFTNGO_API_URL=http://localhost:3001
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
#
# ngrok free tier: avoid HTML warning page on fetch() from the browser
# NEXT_PUBLIC_NGROK_SKIP_BROWSER_WARNING=1

# Optional
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_TWITTER_HANDLE=@liftngo
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@liftngo
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
